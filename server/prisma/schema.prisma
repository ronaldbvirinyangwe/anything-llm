generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model api_keys {
  id            Int      @id @default(autoincrement())
  secret        String?  @unique
  createdBy     Int?
  createdAt     DateTime @default(now())
  lastUpdatedAt DateTime @default(now())
}

model payment_logs {
  id                         Int      @id @default(autoincrement())
  student_id                 Int
  amount                     Float
  payment_method             String
  subscription_duration_days Int?
  recorded_by                Int
  notes                      String?
  created_at                 DateTime @default(now())
  subscription_plan          String?
  recorder                   users    @relation(fields: [recorded_by], references: [id])
  student                    students @relation(fields: [student_id], references: [id])
}

model workspace_documents {
  id                   Int                   @id @default(autoincrement())
  docId                String                @unique
  filename             String
  docpath              String
  workspaceId          Int
  metadata             String?
  pinned               Boolean?              @default(false)
  watched              Boolean?              @default(false)
  createdAt            DateTime              @default(now())
  lastUpdatedAt        DateTime              @default(now())
  document_sync_queues document_sync_queues?
  workspace            workspaces            @relation(fields: [workspaceId], references: [id])
}

model quiz_results {
  id                       Int                     @id @default(autoincrement())
  user_id                  Int
  subject                  String
  topic                    String?
  score                    Int
  total_questions          Int
  correct_answers          Int
  submitted_at             DateTime                @default(now())
  quiz_code                String?
  shared_quiz_id           Int?
  diagnostic_assessment_id String?                 @db.Uuid
  detailed_feedback        Json?
  auto_submitted           Boolean                 @default(false)
  tab_limit_exceeded       Boolean                 @default(false)
  tab_violations           Int                     @default(0)
  feedbacks                quiz_feedback[]
  shared_quiz              shared_quizzes?         @relation(fields: [shared_quiz_id], references: [id])
  diagnostic_assessment    diagnostic_assessments? @relation(fields: [diagnostic_assessment_id], references: [id], onDelete: SetNull)
  user                     users                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  teacher_reviews          teacher_reviews[]

  @@unique([user_id, quiz_code])
  @@unique([diagnostic_assessment_id, topic])
  @@index([user_id, subject])
  @@index([diagnostic_assessment_id])
}

model teacher_reviews {
  id              Int          @id @default(autoincrement())
  quiz_result_id  Int
  question_index  Int
  answer_text     String
  reviewed        Boolean      @default(false)
  teacher_comment String?
  marks_awarded   Int?
  quiz_result     quiz_results @relation(fields: [quiz_result_id], references: [id], onDelete: Cascade)
}

model quiz_feedback {
  id             Int          @id @default(autoincrement())
  quiz_result_id Int
  question       String
  user_answer    String
  correct_answer String?
  feedback       String?
  is_correct     Boolean
  createdAt      DateTime     @default(now())
  quiz_results   quiz_results @relation(fields: [quiz_result_id], references: [id], onDelete: Cascade)
}

model invites {
  id            Int      @id @default(autoincrement())
  code          String   @unique
  status        String   @default("pending")
  claimedBy     Int?
  workspaceIds  String?
  createdAt     DateTime @default(now())
  createdBy     Int
  lastUpdatedAt DateTime @default(now())
}

model system_settings {
  id            Int      @id @default(autoincrement())
  label         String   @unique
  value         String?
  createdAt     DateTime @default(now())
  lastUpdatedAt DateTime @default(now())
}

model users {
  id                           Int                               @id @default(autoincrement())
  username                     String?                           @unique
  password                     String
  pfpFilename                  String?
  role                         String                            @default("default")
  suspended                    Int                               @default(0)
  seen_recovery_codes          Boolean?                          @default(false)
  createdAt                    DateTime                          @default(now())
  lastUpdatedAt                DateTime                          @default(now())
  dailyMessageLimit            Int?
  bio                          String?                           @default("")
  streak                       Int                               @default(0)
  lastActiveDate               DateTime?                         @db.Date
  PushToken                    PushToken[]
  browser_extension_api_keys   browser_extension_api_keys[]
  desktop_mobile_devices       desktop_mobile_devices[]
  embed_chats                  embed_chats[]
  embed_configs                embed_configs[]
  notifications                notifications[]
  parents                      parents[]
  password_reset_tokens        password_reset_tokens[]
  payment_logs                 payment_logs[]
  prompt_history               prompt_history[]
  quiz_results                 quiz_results[]
  diagnostic_assessments       diagnostic_assessments[]
  recovery_codes               recovery_codes[]
  slash_command_presets        slash_command_presets[]
  students                     students[]
  system_prompt_variables      system_prompt_variables[]
  teachers                     teachers[]
  temporary_auth_tokens        temporary_auth_tokens[]
  workspace_agent_invocations  workspace_agent_invocations[]
  workspace_chats              workspace_chats[]
  workspace_parsed_files       workspace_parsed_files[]
  threads                      workspace_threads[]
  workspace_users              workspace_users[]
  organization_memberships     organization_memberships[]
  submittedSchoolVerifications school_verification_submissions[] @relation("SchoolVerificationSubmitter")
  reviewedSchoolVerifications  school_verification_submissions[] @relation("SchoolVerificationReviewer")
  review_items                 review_items[]
  review_attempts              review_attempts[]
}

model diagnostic_assessments {
  id            String    @id @default(uuid()) @db.Uuid
  user_id       Int
  subject       String
  curriculum    String
  academicLevel String
  grade         String
  status        String    @default("generating")
  questionCount Int
  questions     Json?
  responses     Json?
  report        Json?
  overallScore  Int?
  provider      String?
  model         String?
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  submittedAt   DateTime?

  user         users          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  quiz_results quiz_results[]

  @@index([user_id, status])
  @@index([user_id, subject, createdAt])
}

model recovery_codes {
  id        Int      @id @default(autoincrement())
  user_id   Int
  code_hash String
  createdAt DateTime @default(now())
  user      users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model password_reset_tokens {
  id        Int      @id @default(autoincrement())
  user_id   Int
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model document_vectors {
  id            Int      @id @default(autoincrement())
  docId         String
  vectorId      String
  createdAt     DateTime @default(now())
  lastUpdatedAt DateTime @default(now())
}

model vector_table {
  id        String                @id @default(dbgenerated("nextval('vector_table_id_seq'::regclass)"))
  name      String
  embedding Unsupported("vector")
  metadata  Json?
  createdAt DateTime              @default(now())
  namespace String                @default("default")

  @@index([namespace])
}

model welcome_messages {
  id         Int      @id @default(autoincrement())
  user       String
  response   String
  orderIndex Int?
  createdAt  DateTime @default(now())
}

model workspaces {
  id                           Int                            @id @default(autoincrement())
  name                         String
  slug                         String                         @unique
  vectorTag                    String?
  createdAt                    DateTime                       @default(now())
  openAiTemp                   Float?
  openAiHistory                Int                            @default(20)
  lastUpdatedAt                DateTime                       @default(now())
  openAiPrompt                 String?
  similarityThreshold          Float?                         @default(0.25)
  chatProvider                 String?
  chatModel                    String?
  topN                         Int?                           @default(4)
  chatMode                     String?                        @default("chat")
  pfpFilename                  String?
  agentProvider                String?
  agentModel                   String?
  queryRefusalResponse         String?
  vectorSearchMode             String?                        @default("default")
  embed_configs                embed_configs[]
  prompt_history               prompt_history[]
  workspace_agent_invocations  workspace_agent_invocations[]
  documents                    workspace_documents[]
  workspace_parsed_files       workspace_parsed_files[]
  workspace_suggested_messages workspace_suggested_messages[]
  threads                      workspace_threads[]
  workspace_users              workspace_users[]
  courses                      courses[]
}

model workspace_threads {
  id                     Int                      @id @default(autoincrement())
  name                   String
  slug                   String                   @unique
  workspace_id           Int
  user_id                Int?
  createdAt              DateTime                 @default(now())
  lastUpdatedAt          DateTime                 @default(now())
  workspace_parsed_files workspace_parsed_files[]
  user                   users?                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  workspace              workspaces               @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@index([workspace_id])
  @@index([user_id])
}

model workspace_suggested_messages {
  id            Int        @id @default(autoincrement())
  workspaceId   Int
  heading       String
  message       String
  createdAt     DateTime   @default(now())
  lastUpdatedAt DateTime   @default(now())
  workspace     workspaces @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model workspace_chats {
  id             Int      @id @default(autoincrement())
  workspaceId    Int
  prompt         String
  response       String
  include        Boolean  @default(true)
  user_id        Int?
  thread_id      Int?
  api_session_id String?
  createdAt      DateTime @default(now())
  lastUpdatedAt  DateTime @default(now())
  feedbackScore  Boolean?
  users          users?   @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model workspace_agent_invocations {
  id            Int        @id @default(autoincrement())
  uuid          String     @unique
  prompt        String
  closed        Boolean    @default(false)
  user_id       Int?
  thread_id     Int?
  workspace_id  Int
  createdAt     DateTime   @default(now())
  lastUpdatedAt DateTime   @default(now())
  user          users?     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  workspace     workspaces @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@index([uuid])
}

model workspace_users {
  id            Int        @id @default(autoincrement())
  user_id       Int
  workspace_id  Int
  createdAt     DateTime   @default(now())
  lastUpdatedAt DateTime   @default(now())
  users         users      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  workspaces    workspaces @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
}

model cache_data {
  id            Int       @id @default(autoincrement())
  name          String
  data          String
  belongsTo     String?
  byId          Int?
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  lastUpdatedAt DateTime  @default(now())
}

model embed_configs {
  id                         Int           @id @default(autoincrement())
  uuid                       String        @unique
  enabled                    Boolean       @default(false)
  chat_mode                  String        @default("query")
  allowlist_domains          String?
  allow_model_override       Boolean       @default(false)
  allow_temperature_override Boolean       @default(false)
  allow_prompt_override      Boolean       @default(false)
  max_chats_per_day          Int?
  max_chats_per_session      Int?
  message_limit              Int?          @default(20)
  workspace_id               Int
  createdBy                  Int?
  usersId                    Int?
  createdAt                  DateTime      @default(now())
  embed_chats                embed_chats[]
  users                      users?        @relation(fields: [usersId], references: [id])
  workspace                  workspaces    @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
}

model embed_chats {
  id                     Int           @id @default(autoincrement())
  prompt                 String
  response               String
  session_id             String
  include                Boolean       @default(true)
  connection_information String?
  embed_id               Int
  usersId                Int?
  createdAt              DateTime      @default(now())
  embed_config           embed_configs @relation(fields: [embed_id], references: [id], onDelete: Cascade)
  users                  users?        @relation(fields: [usersId], references: [id])
}

model event_logs {
  id         Int      @id @default(autoincrement())
  event      String
  metadata   String?
  userId     Int?
  occurredAt DateTime @default(now())

  @@index([event])
}

model slash_command_presets {
  id            Int      @id @default(autoincrement())
  command       String
  prompt        String
  description   String
  uid           Int      @default(0)
  userId        Int?
  createdAt     DateTime @default(now())
  lastUpdatedAt DateTime @default(now())
  user          users?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([uid, command])
}

model document_sync_queues {
  id             Int                        @id @default(autoincrement())
  staleAfterMs   Int                        @default(604800000)
  nextSyncAt     DateTime
  createdAt      DateTime                   @default(now())
  lastSyncedAt   DateTime                   @default(now())
  workspaceDocId Int                        @unique
  runs           document_sync_executions[]
  workspaceDoc   workspace_documents        @relation(fields: [workspaceDocId], references: [id], onDelete: Cascade)
}

model document_sync_executions {
  id        Int                  @id @default(autoincrement())
  queueId   Int
  status    String               @default("unknown")
  result    String?
  createdAt DateTime             @default(now())
  queue     document_sync_queues @relation(fields: [queueId], references: [id], onDelete: Cascade)
}

model browser_extension_api_keys {
  id            Int      @id @default(autoincrement())
  key           String   @unique
  user_id       Int?
  createdAt     DateTime @default(now())
  lastUpdatedAt DateTime @updatedAt
  user          users?   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model temporary_auth_tokens {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model system_prompt_variables {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String?
  description String?
  type        String   @default("system")
  userId      Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        users?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model prompt_history {
  id          Int        @id @default(autoincrement())
  workspaceId Int
  prompt      String
  modifiedBy  Int?
  modifiedAt  DateTime   @default(now())
  user        users?     @relation(fields: [modifiedBy], references: [id])
  workspace   workspaces @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model desktop_mobile_devices {
  id         Int      @id @default(autoincrement())
  deviceOs   String
  deviceName String
  token      String   @unique
  approved   Boolean  @default(false)
  userId     Int?
  createdAt  DateTime @default(now())
  user       users?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model workspace_parsed_files {
  id                 Int                @id @default(autoincrement())
  filename           String             @unique
  workspaceId        Int
  userId             Int?
  threadId           Int?
  metadata           String?
  tokenCountEstimate Int?               @default(0)
  createdAt          DateTime           @default(now())
  thread             workspace_threads? @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user               users?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace          workspaces         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([userId])
}

model students {
  id                             Int                              @id @default(autoincrement())
  name                           String
  age                            Int
  academicLevel                  String
  curriculum                     String
  grade                          String
  user_id                        Int                              @unique
  createdAt                      DateTime                         @default(now())
  subscription_expiration_date   DateTime?
  subscription_payment_poll_url  String?
  subscription_plan              String?
  subscription_status            SubscriptionStatus               @default(none)
  subscription_updated_at        DateTime                         @updatedAt
  parent_students                parent_students[]
  payment_logs                   payment_logs[]
  linkCodes                      student_link_codes[]
  student_quiz_assignments       student_quiz_assignments[]
  user                           users                            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  teacher_students               teacher_students[]
  notificationSettings           ParentNotificationSettings[]
  student_courses                student_courses[] // ← add this
  student_lesson_progress        student_lesson_progress[] // ← add this
  student_assignment_submissions student_assignment_submissions[]
  class_students                 class_students[]

  @@map("students")
}

model teachers {
  id                Int                              @id @default(autoincrement())
  name              String
  school            String
  user_id           Int                              @unique
  createdAt         DateTime                         @default(now())
  class_links       class_links[]
  shared_quizzes    shared_quizzes[]
  teacher_students  teacher_students[]
  class_teachers    class_teachers[]
  assignments       course_assignments[]
  gradedSubmissions student_assignment_submissions[] @relation("SubmissionGrader")
  user              users                            @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model parents {
  id                   Int                          @id @default(autoincrement())
  name                 String
  user_id              Int                          @unique
  email                String?
  createdAt            DateTime                     @default(now())
  studentName          String?
  parent_students      parent_students[]
  user                 users                        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  notificationSettings ParentNotificationSettings[]
}

model teacher_students {
  id        Int      @id @default(autoincrement())
  teacherId Int
  studentId Int
  subject   String?
  createdAt DateTime @default(now())
  student   students @relation(fields: [studentId], references: [id])
  teacher   teachers @relation(fields: [teacherId], references: [id])

  @@unique([teacherId, studentId, subject])
}

model shared_quizzes {
  id                  Int                        @id @default(autoincrement())
  teacher_id          Int
  quiz_code           String                     @unique
  subject             String
  topic               String
  difficulty          String?
  quiz_content        String
  is_class_specific   Boolean                    @default(false)
  created_at          DateTime                   @default(now())
  tab_limit           Int                        @default(1)
  time_limit          Int                        @default(0)
  quiz_results        quiz_results[]
  teacher             teachers                   @relation(fields: [teacher_id], references: [id])
  student_assignments student_quiz_assignments[]
}

model student_quiz_assignments {
  id          Int            @id @default(autoincrement())
  quiz_id     Int
  student_id  Int
  assigned_at DateTime       @default(now())
  completed   Boolean        @default(false)
  quiz        shared_quizzes @relation(fields: [quiz_id], references: [id])
  student     students       @relation(fields: [student_id], references: [id])

  @@unique([quiz_id, student_id])
}

model student_link_codes {
  id        Int       @id @default(autoincrement())
  studentId Int       @map("student_id")
  code      String    @unique @db.VarChar(8)
  expiresAt DateTime  @map("expires_at")
  used      Boolean   @default(false)
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  student   students  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("student_link_codes")
}

model notifications {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String?  @default("general")
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      users    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model parent_students {
  id        Int      @id @default(autoincrement())
  parentId  Int
  studentId Int
  createdAt DateTime @default(now())
  linkedAt  DateTime @default(now()) @map("linked_at")
  parent    parents  @relation(fields: [parentId], references: [id])
  student   students @relation(fields: [studentId], references: [id])

  @@unique([parentId, studentId])
}

model class_links {
  id        Int      @id @default(autoincrement())
  teacherId Int
  subject   String
  classCode String   @unique
  createdAt DateTime @default(now())
  teacher   teachers @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

model SavedQuiz {
  id          Int      @id @default(autoincrement())
  userId      Int
  subject     String
  grade       String
  difficulty  String   @default("medium")
  userMessage String?
  questions   Json
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  @@map("saved_quizzes")
}

model SavedFlashcardSet {
  id          Int      @id @default(autoincrement())
  userId      Int
  subject     String
  grade       String
  difficulty  String   @default("medium")
  userMessage String?
  cards       Json
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  @@map("saved_flashcard_sets")
}

model WeakAreaCard {
  id             Int      @id @default(autoincrement())
  userId         Int
  subject        String
  question       String
  wrongAnswer    String?
  correctAnswer  String
  explanation    String?
  timesWrong     Int      @default(1)
  resolved       Boolean  @default(false)
  firstFlaggedAt DateTime @default(now())
  lastWrongAt    DateTime @default(now())

  @@map("weak_area_cards")
}

model review_items {
  id            String    @id @default(uuid()) @db.Uuid
  userId        Int
  fingerprint   String
  subject       String
  topic         String
  prompt        String
  options       Json
  correctOption String
  explanation   String?
  status        String    @default("active")
  step          Int       @default(0)
  dueOn         DateTime? @db.Date
  masteredAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user     users             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sources  review_sources[]
  attempts review_attempts[]

  @@unique([userId, fingerprint])
  @@index([userId, status, dueOn])
}

model review_sources {
  id                String   @id @default(uuid()) @db.Uuid
  userId            Int
  reviewItemId      String   @db.Uuid
  sourceType        String
  sourceId          String
  sourceQuestionKey String
  occurredAt        DateTime
  createdAt         DateTime @default(now())

  item review_items @relation(fields: [reviewItemId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceType, sourceId, sourceQuestionKey])
  @@index([reviewItemId, occurredAt])
}

model review_attempts {
  id                String    @id @default(uuid()) @db.Uuid
  userId            Int
  reviewItemId      String    @db.Uuid
  clientOperationId String    @db.Uuid
  selectedOption    String
  correct           Boolean
  evidenceApplied   Boolean
  disposition       String
  stepBefore        Int
  stepAfter         Int
  dueOnAfter        DateTime? @db.Date
  attemptedAt       DateTime
  receivedAt        DateTime  @default(now())

  user users        @relation(fields: [userId], references: [id], onDelete: Cascade)
  item review_items @relation(fields: [reviewItemId], references: [id], onDelete: Cascade)

  @@unique([userId, clientOperationId])
  @@index([reviewItemId, attemptedAt])
}

model study_plans {
  id           Int       @id @default(autoincrement())
  user_id      Int
  workspace_id Int
  subject      String?
  exam_date    DateTime?
  topics       String[]
  study_hours  Float
  days_off     String[]
  plan_content String
  created_at   DateTime  @default(now())
  sessions     Json      @default("[]")
  last_active  DateTime? @db.Timestamptz(6)
  status       String    @default("active")

  @@index([user_id])
  @@map("study_plans")
}

model PushToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  platform  String   @default("unknown") @db.VarChar(20)
  createdAt DateTime @default(now())
  users     users    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
}

enum SubscriptionStatus {
  pending
  paid
  none
}

model ParentNotificationSettings {
  id             Int      @id @default(autoincrement())
  parentId       Int
  studentId      Int
  weeklyDigest   Boolean  @default(true)
  alertsEnabled  Boolean  @default(true)
  alertThreshold Int      @default(40)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  parent  parents  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student students @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@map("parent_notification_settings")
}

model courses {
  id            Int      @id @default(autoincrement())
  subject       String
  curriculum    String
  academicLevel String
  grade         String
  status        String   @default("generating")
  rating        Float?
  workspaceId   Int? // ← new
  createdAt     DateTime @default(now())
  lastUpdatedAt DateTime @updatedAt

  workspace          workspaces?       @relation(fields: [workspaceId], references: [id])
  modules            course_modules[]
  student_enrolments student_courses[]

  @@unique([subject, curriculum, academicLevel, grade])
  @@index([curriculum, academicLevel, grade])
}

model course_modules {
  id                  Int    @id @default(autoincrement())
  courseId            Int
  position            Int
  title               String
  lockedUntilModuleId Int?
  status              String @default("not_started")

  course      courses              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     course_lessons[]
  assignments course_assignments[]

  @@index([courseId])
}

model course_lessons {
  id          Int     @id @default(autoincrement())
  moduleId    Int
  position    Int
  title       String
  contentMd   String?
  durationMin Int?

  module   course_modules            @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress student_lesson_progress[]

  @@index([moduleId])
}

model course_assignments {
  id              Int       @id @default(autoincrement())
  moduleId        Int?
  teacherId       Int?
  title           String
  description     String?
  stepsJson       Json?
  etaHours        String?
  subject         String?
  assignmentType  String    @default("homework")
  status          String    @default("draft")
  maxPoints       Float?
  dueAt           DateTime?
  publishedAt     DateTime?
  submissionModes Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  module      course_modules?                  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  teacher     teachers?                        @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classes     assignment_classes[]
  submissions student_assignment_submissions[]

  @@index([moduleId])
  @@index([teacherId, status, dueAt])
}

model assignment_classes {
  id           Int      @id @default(autoincrement())
  assignmentId Int
  classId      Int
  createdAt    DateTime @default(now())

  assignment course_assignments @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  class      education_classes  @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, classId])
  @@index([classId, assignmentId])
}

model student_courses {
  id         Int      @id @default(autoincrement())
  studentId  Int
  courseId   Int
  enrolledAt DateTime @default(now())

  student students @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  courses  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([studentId])
}

model student_lesson_progress {
  id        Int       @id @default(autoincrement())
  studentId Int
  lessonId  Int
  done      Boolean   @default(false)
  doneAt    DateTime?

  student students       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson  course_lessons @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
  @@index([studentId])
}

model student_assignment_submissions {
  id                    Int       @id @default(autoincrement())
  studentId             Int
  assignmentId          Int
  sourceClassId         Int?
  submissionText        String?
  submissionLink        String?
  status                String    @default("assigned")
  feedback              String?
  assignedAt            DateTime  @default(now())
  firstSubmittedAt      DateTime?
  submittedAt           DateTime?
  scorePoints           Float?
  gradedAt              DateTime?
  gradedByTeacherId     Int?
  lastClientOperationId String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  student     students           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignment  course_assignments @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  sourceClass education_classes? @relation(fields: [sourceClassId], references: [id], onDelete: SetNull)
  gradedBy    teachers?          @relation("SubmissionGrader", fields: [gradedByTeacherId], references: [id], onDelete: SetNull)

  @@unique([assignmentId, studentId])
  @@index([studentId])
  @@index([assignmentId])
  @@index([sourceClassId, assignmentId])
}

model organizations {
  id                      Int                               @id @default(autoincrement())
  code                    String                            @unique
  name                    String
  type                    String
  parentId                Int?
  active                  Boolean                           @default(true)
  metadata                Json?
  createdAt               DateTime                          @default(now())
  updatedAt               DateTime                          @updatedAt
  parent                  organizations?                    @relation("OrganizationTree", fields: [parentId], references: [id], onDelete: Restrict)
  children                organizations[]                   @relation("OrganizationTree")
  memberships             organization_memberships[]
  classes                 education_classes[]               @relation("SchoolClasses")
  departmentClasses       education_classes[]               @relation("ClassDepartment")
  verificationSubmissions school_verification_submissions[]

  @@index([parentId])
  @@index([type])
}

model organization_memberships {
  id             Int           @id @default(autoincrement())
  organizationId Int
  userId         Int
  role           String
  canViewPii     Boolean       @default(false)
  validFrom      DateTime      @default(now())
  validTo        DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   organizations @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           users         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, role])
  @@index([userId])
}

model academic_periods {
  id        Int                 @id @default(autoincrement())
  code      String              @unique
  name      String
  year      Int
  term      Int?
  startsAt  DateTime
  endsAt    DateTime
  active    Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  classes   education_classes[]
}

model education_classes {
  id                    Int                              @id @default(autoincrement())
  code                  String                           @unique
  schoolId              Int
  departmentId          Int?
  academicPeriodId      Int
  name                  String
  grade                 String?
  curriculum            String?
  subject               String?
  active                Boolean                          @default(true)
  createdAt             DateTime                         @default(now())
  updatedAt             DateTime                         @updatedAt
  school                organizations                    @relation("SchoolClasses", fields: [schoolId], references: [id], onDelete: Restrict)
  department            organizations?                   @relation("ClassDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  academicPeriod        academic_periods                 @relation(fields: [academicPeriodId], references: [id], onDelete: Restrict)
  students              class_students[]
  teachers              class_teachers[]
  assignments           assignment_classes[]
  assignmentSubmissions student_assignment_submissions[]

  @@index([schoolId])
  @@index([departmentId])
  @@index([academicPeriodId])
}

model class_students {
  id         Int               @id @default(autoincrement())
  classId    Int
  studentId  Int
  status     String            @default("active")
  enrolledAt DateTime          @default(now())
  leftAt     DateTime?
  class      education_classes @relation(fields: [classId], references: [id], onDelete: Cascade)
  student    students          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId])
  @@index([studentId])
}

model class_teachers {
  id        Int               @id @default(autoincrement())
  classId   Int
  teacherId Int
  subject   String?
  role      String            @default("teacher")
  createdAt DateTime          @default(now())
  class     education_classes @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher   teachers          @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([classId, teacherId, subject])
  @@index([teacherId])
}

model school_verification_submissions {
  id                   Int           @id @default(autoincrement())
  schoolId             Int
  submittedBy          Int
  proposedName         String?
  schoolLevel          String
  provinceId           Int
  districtId           Int
  sector               String
  responsibleAuthority String
  address              String?
  notes                String?
  status               String        @default("pending")
  reviewedBy           Int?
  reviewNotes          String?
  reviewedAt           DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  school               organizations @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  submitter            users         @relation("SchoolVerificationSubmitter", fields: [submittedBy], references: [id], onDelete: Cascade)
  reviewer             users?        @relation("SchoolVerificationReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([schoolId, status])
  @@index([submittedBy])
  @@index([status, createdAt])
}
